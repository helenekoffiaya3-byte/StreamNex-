FROM node:24-alpine

WORKDIR /usr/src/app

# Toolchain required to compile native Node modules such as better-sqlite3.
RUN apk add --no-cache python3 make g++

COPY package*.json ./

# Install production dependencies and force a native build test.
RUN npm install --omit=dev --build-from-source

COPY . .

RUN mkdir -p /usr/src/app/data /usr/src/app/storage/videos \
  && chown -R node:node /usr/src/app

ENV NODE_ENV=production
ENV PORT=3000

USER node

EXPOSE 3000

CMD ["node", "server.js"]

FROM node:20-alpine

WORKDIR /usr/src/app

# Toolchain required to compile native Node modules such as better-sqlite3.
RUN apk add --no-cache python3 make g++

COPY package*.json ./

# Install production dependencies and force a native build test.
RUN npm install --omit=dev --build-from-source

COPY . .

ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000

CMD ["node", "server.js"]

# StreamLive — configuration locale
# Ne jamais mettre de secret dans Git.
# En production, renseignez ces variables dans l'environnement du serveur.

# Source EPG XMLTV officielle ou publiée par un agrégateur autorisé.
# Laisser vide tant qu'aucune source réelle n'est configurée.
SOURCE_EPG_URL=

# Mapping JSON entre les identifiants XMLTV de la source et les IDs StreamLive.
# Exemple de structure (sans données fictives) :
# EPG_CHANNEL_MAP_JSON={"<source-channel-id>":"<streamlive-channel-id>"}
EPG_CHANNEL_MAP_JSON=

# Guides communautaires/publics : désactivés par défaut. À activer explicitement avec les deux variables ci-dessous.
EPG_USE_IPTV_ORG_GUIDES=false
EPG_ALLOW_PUBLISHED_FALLBACK=false

# La provenance et les mappings EPG sont déclarés dans config/official-guides.json.

# Limite de taille du téléchargement XMLTV (compressé ou non), protection mémoire.
EPG_MAX_DOWNLOAD_BYTES=104857600

# Synchronisation EPG (toutes les 6 heures par défaut)
EPG_SYNC_CRON=0 */6 * * *
EPG_SYNC_ON_START=true

# Secret serveur pour déclencher une synchronisation EPG via POST /api/epg/sync.
# Ne jamais mettre la valeur réelle dans GitHub.
EPG_SYNC_TOKEN=

# Authentification JWT des téléchargements MP4
# Secret partagé UNIQUEMENT côté serveur pour vérifier les JWT HS256.
# Le JWT doit contenir : sub (ID utilisateur), exp (NumericDate).
# Facultatif : iss/aud si votre fournisseur JWT les utilise.
STREAMLIVE_AUTH_JWT_SECRET=
STREAMLIVE_AUTH_JWT_ISSUER=
STREAMLIVE_AUTH_JWT_AUDIENCE=
STREAMLIVE_AUTH_JWT_EXPIRES_IN=24h
STREAMLIVE_AUTH_RETURN_TOKEN=false

# Premier administrateur (utilisé uniquement par npm run db:init)
INIT_ADMIN_USERNAME=
INIT_ADMIN_EMAIL=
INIT_ADMIN_PASSWORD=

# Stockage des MP4 autorisés
STREAMLIVE_MEDIA_DIR=

# Administration privée (serveur uniquement)
STREAMLIVE_ADMIN_EMAIL=streamliveprod2inc@gmail.com

# RTI 1 — enregistrement éditorial réel
# Vous créez/fournissez vous-même la source autorisée. Ne jamais commit sa valeur réelle.
RTI1_RECORD_AUTOSTART=false
RTI1_RECORD_ENABLED=true
RTI1_RECORD_SOURCE_URL=
RTI1_RECORD_ROOT=
RTI1_RECORD_INTERVAL_MS=15000
RTI1_RECORD_TRANSCODE_FALLBACK=false
RTI1_REPLAY_HLS_ROOT=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# New premium channel LIVE sources — URLs must be authorized and supplied at runtime.
C_PLUS_POP_HLS_URL=
C_PLUS_MAGIC_HLS_URL=
C_PLUS_CINEMA_HLS_URL=
C_PLUS_FAMILY_HLS_URL=
C_PLUS_ACTION_HLS_URL=
ACTION_HLS_URL=
TF1_SERIES_FILMS_HLS_URL=
S_PLUS_PRIME_HLS_URL=

# S+ channels — leave empty until an authorized real source URL is available
S_PLUS_PRIME_HLS_URL=
S_PLUS_CINE_HLS_URL=
S_PLUS_KIDS_HLS_URL=

# S+ StreamLive channels
S_PLUS_FICTION_HLS_URL=
S_PLUS_CHANNEL_HLS_URL=
S_PLUS_MUSIC_HLS_URL=
S_PLUS_TV_HLS_URL=
S_PLUS_FAMILY_HLS_URL=
S_PLUS_SPORT_1_HLS_URL=
S_PLUS_SPORT_2_HLS_URL=
S_PLUS_SPORT_3_HLS_URL=
S_PLUS_SPORT_4_HLS_URL=
S_PLUS_SPORT_5_HLS_URL=
S_PLUS_SPORT_6_HLS_URL=
S_PLUS_MOVIES_HLS_URL=

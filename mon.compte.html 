<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mon compte - STREAMNEX</title>
<style>
* { margin:0; padding:0; box-sizing:border-box; font-family: -apple-system, sans-serif; }
body { background:#0a0a0a; color:white; display:flex; justify-content:center; }
.container { width:100%; max-width:390px; min-height:100vh; background:#121212; padding:0 20px 30px; }
.header { background: linear-gradient(180deg, #0f0f0f 0%, #121212 100%); padding:20px 0 10px; position:relative; overflow:hidden; }
.logo { font-size:32px; font-weight:900; color:#2ECC71; text-align:center; filter: drop-shadow(0 0 8px #2ECC71); letter-spacing: -1px; }
.logo::after { content:""; display:block; width:100%; height:60px; background: radial-gradient(ellipse at center top, rgba(46,204,113,0.3) 0%, transparent 70%); margin-top:-10px; }
.top-bar { display:flex; align-items:center; justify-content:space-between; margin-bottom:5px; }
.back { font-size:24px; cursor:pointer; }
.title { font-size:22px; font-weight:700; text-align:center; flex:1; }
.profile-wrap { display:flex; flex-direction:column; align-items:center; margin:25px 0; }
.profile { width:130px; height:130px; border-radius:50%; border:4px solid #2ECC71; object-fit:cover; }
.avatars { display:flex; gap:10px; justify-content:center; margin:15px 0 5px; flex-wrap:wrap; }
.avatar { width:52px; height:52px; border-radius:50%; border:2px solid transparent; cursor:pointer; transition:0.2s; background:#1e1e1e; display:flex; align-items:center; justify-content:center; font-size:24px; }
.avatar.active { border-color:#2ECC71; box-shadow:0 0 12px rgba(46,204,113,0.6); transform:scale(1.1); }
.avatar-label { text-align:center; color:#7abf8a; font-size:12px; margin-bottom:18px; }
.field { margin-bottom:14px; }
.field label { color:#888; font-size:13px; margin-bottom:6px; display:block; }
.input-box { background:#1e1e1e; border:1.5px solid #2a4a30; border-radius:14px; padding:14px 16px; display:flex; justify-content:space-between; align-items:center; }
.input-box input { background:transparent; border:none; color:white; font-size:16px; font-weight:600; width:80%; outline:none; }
.edit-icon { color:#2ECC71; }
.info { text-align:center; color:#7abf8a; font-size:12px; margin:18px 0; }
.btn-green { width:100%; background:#0fd068; color:black; font-weight:700; padding:16px; border-radius:30px; border:none; font-size:16px; cursor:pointer; margin-bottom:12px; }
.btn-red { width:100%; background:transparent; color:#ff5a5a; border:1.5px solid #ff5a5a; padding:14px; border-radius:30px; font-size:15px; font-weight:600; cursor:pointer; }
.warning { text-align:center; font-size:11px; color:#666; margin-top:8px; }

/* Popup */
.modal { display:none; position:fixed; inset:0; background:rgba(0,0,0,0.8); align-items:center; justify-content:center; z-index:10; }
.modal.show { display:flex; }
.modal-box { background:#1e1e1e; padding:24px; border-radius:20px; width:90%; max-width:320px; text-align:center; border:1px solid #333; }
.modal-box h3 { margin-bottom:8px; }
.modal-box p { color:#aaa; font-size:13px; margin-bottom:18px; }
.modal-btns { display:flex; gap:10px; }
</style>
</head>
<body>
<div class="container">
  <div class="header">
    <div class="top-bar"><span class="back">←</span><span class="logo">STREAMNEX</span><span style="width:24px"></span></div>
    <div class="title">Mon compte</div>
  </div>

  <div class="profile-wrap">
    <img id="mainPhoto" class="profile" src="https://i.pravatar.cc/150?img=12" alt="profile">
  </div>

  <div class="avatars" id="avatars">
    <div class="avatar active" data-emoji="😺">😺</div>
    <div class="avatar" data-emoji="🤖">🤖</div>
    <div class="avatar" data-emoji="🦊">🦊</div>
    <div class="avatar" data-emoji="👽">👽</div>
    <div class="avatar" data-emoji="🐼">🐼</div>
    <div class="avatar" data-emoji="👹">👹</div>
  </div>
  <div class="avatar-label">Choisir votre avatar</div>

  <div class="field">
    <label>Nom d'utilisateur</label>
    <div class="input-box"><input value="Alex" id="username"><span class="edit-icon">✎</span></div>
  </div>
  <div class="field">
    <label>Email</label>
    <a class="input-box" href="modifier-email.html" id="email-link" style="color:inherit;text-decoration:none"><input value="Chargement…" id="email" readonly aria-label="Adresse email actuelle" style="cursor:pointer"><span class="edit-icon">✉</span></a>
  </div>

  <div class="info">Cette application est 100% gratuite.</div>

  <button class="btn-green">Changer le mot de passe</button>
  <button class="btn-red" id="deleteBtn">🗑 Supprimer le compte</button>
  <div class="warning">Cette action est irréversible.</div>
</div>

<div class="modal" id="modal">
  <div class="modal-box">
    <h3>Supprimer ton compte ?</h3>
    <p>Toutes tes listes et ton historique seront perdus définitivement.</p>
    <div class="modal-btns">
      <button class="btn-green" style="background:#333; color:white" id="cancel">Annuler</button>
      <button class="btn-red" id="confirmDelete">Supprimer</button>
    </div>
  </div>
</div>

<script type="module">
import { getUser, handleAuthCallback } from "https://esm.sh/@netlify/identity";
try {
  await handleAuthCallback();
  const currentUser = await getUser();
  if (!currentUser) window.location.replace("connexion.html?redirect=" + encodeURIComponent("mon.compte.html%20"));
  else {
    document.getElementById("email").value = currentUser.email || "";
    document.getElementById("username").value = currentUser.user_metadata?.full_name || currentUser.email?.split("@")[0] || "Utilisateur";
  }
} catch (error) { console.error("Netlify Identity:", error); }
const avatars = document.querySelectorAll('.avatar');
const mainPhoto = document.getElementById('mainPhoto');
const pics = ["https://i.pravatar.cc/150?img=12","https://i.pravatar.cc/150?img=32","https://i.pravatar.cc/150?img=8","https://i.pravatar.cc/150?img=15","https://i.pravatar.cc/150?img=28","https://i.pravatar.cc/150?img=19"];

avatars.forEach((a,i)=>{
  a.addEventListener('click',()=>{
    avatars.forEach(x=>x.classList.remove('active'));
    a.classList.add('active');
    mainPhoto.src = pics[i];
  });
});

const modal = document.getElementById('modal');
document.getElementById('deleteBtn').onclick = ()=> modal.classList.add('show');
document.getElementById('cancel').onclick = ()=> modal.classList.remove('show');
document.getElementById('confirmDelete').onclick = ()=>{
  alert('Compte supprimé - redirection...');
  modal.classList.remove('show');
};
</script>
</body>
</html>